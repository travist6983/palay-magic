# PropLab configuration. Copy to .env and fill in.
# Everything degrades gracefully when a key is absent.

# Anthropic API key for the LLM narrative tasks (backend/llm/). Optional.
# Without it, deep-dive notes are omitted and the UI shows "narrative unavailable".
ANTHROPIC_API_KEY=

# The Odds API key (https://the-odds-api.com). Optional.
# Free tier is 500 requests/month; PropLab hard-caps usage in code.
# Without it, implied team totals come from nflverse `schedules` spread_line/total_line.
ODDS_API_KEY=

# --- Optional overrides (sane defaults in backend/config.py) ---
# PROPLAB_DB_PATH=data/proplab.duckdb
# PROPLAB_RAW_DIR=data/raw
# PROPLAB_SEASONS=2023,2024,2025,2026
# PROPLAB_ANTHROPIC_MODEL=claude-sonnet-4-6
# PROPLAB_LLM_CALLS_PER_REFRESH=150
# PROPLAB_ODDS_MONTHLY_BUDGET=500
# PROPLAB_LOG_LEVEL=INFO
